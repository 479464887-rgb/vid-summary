<!DOCTYPE html><html><head><meta charset="UTF-8"><style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:13px;color:#fff;background:#0f0f0f;width:280px;padding:16px}
h1{font-size:15px;color:#3ea6ff;margin-bottom:12px}
.stat{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #272727;color:#aaa}
.btn{display:block;width:100%;padding:10px;text-align:center;font-size:13px;font-weight:600;border:1px solid #30363d;border-radius:8px;cursor:pointer;background:#272727;color:#fff;margin-top:10px}
.btn:hover{background:#3f3f3f}
</style></head><body>
<h1>🤖 VidSummary</h1>
<div class="stat"><span>今日已用</span><span id="count">-</span></div>
<button class="btn" id="settings">⚙️ 设置</button>
<p style="margin-top:10px;font-size:11px;color:#717171;text-align:center">YouTube视频一键AI摘要</p>
<script src="popup.js"></script>
</body></html>
