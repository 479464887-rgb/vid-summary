<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><title>VidSummary · 设置</title><style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:14px;color:#fff;background:#0f0f0f;max-width:500px;margin:40px auto;padding:0 20px}
h1{font-size:22px;color:#3ea6ff;margin-bottom:24px}
.card{background:#272727;border:1px solid #3f3f3f;border-radius:8px;padding:20px;margin-bottom:20px}
.card h2{font-size:15px;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid #3f3f3f}
.field{margin-bottom:14px}
.field label{display:block;font-weight:600;margin-bottom:4px}
.field .hint{font-size:12px;color:#aaa;margin-bottom:4px}
.field input{width:100%;padding:8px 12px;font-size:13px;border:1px solid #3f3f3f;border-radius:6px;background:#0f0f0f;color:#fff}
.btn{padding:8px 20px;font-size:14px;font-weight:600;border-radius:6px;cursor:pointer;border:none;background:#065fd4;color:#fff}
#status{margin-left:12px;font-size:13px;color:#3fb950;display:none}
</style></head><body>
<h1>🤖 VidSummary 设置</h1>
<div class="card"><h2>API</h2>
<div class="field"><label>DeepSeek API Key</label><div class="hint">platform.deepseek.com</div><input type="password" id="key" placeholder="sk-..." autocomplete="off"></div>
</div>
<div class="card"><h2>限制</h2><div class="field"><label>每日免费次数</label><input type="number" id="limit" min="1" max="100" value="10"></div></div>
<div class="card"><button class="btn" id="save">保存</button><span id="status"></span></div>
<script src="options.js"></script>
</body></html>
